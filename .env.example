# --- Network ------------------------------------------------------------------
# base-sepolia (testnet, default) or base (mainnet). Picks src/config/deployments/<network>.json.
NEXT_PUBLIC_NETWORK=base-sepolia
# Browser RPC (public). On mainnet use a paid provider endpoint restricted to your domain.
NEXT_PUBLIC_RPC_URL=
# Server RPC (may carry an API key; never exposed to the browser)
RPC_URL=
# Block range per eth_getLogs call for the Transactions page (match your RPC provider's limit)
LOGS_BLOCK_RANGE=10000

# --- Keys ---------------------------------------------------------------------
# Deployer: deploys contracts, then hands ownership to OWNER_ADDRESS. Testnet: generated by
# `node scripts/deploy.mjs --network base-sepolia` if missing. Mainnet: required, never reuse the testnet key,
# and keep it off the web server (deploy from a local machine; it is not needed at runtime).
DEPLOYER_PRIVATE_KEY=
# Protocol agent (price pusher / flagship rebalancer). Mainnet: required, its own key, never the deployer or owner.
# Testnet falls back to DEPLOYER_PRIVATE_KEY.
STOCK_AGENT_PRIVATE_KEY=
# Bearer secret for every /api/stocks/agent action and verbose /api/health. Vercel cron sends CRON_SECRET.
STOCK_AGENT_SECRET=
CRON_SECRET=

# --- Protocol roles (used by scripts/deploy.mjs) ------------------------------
# Final owner of oracle, venue and factory. Mainnet: required, a multisig (Safe). It must acceptOwnership().
OWNER_ADDRESS=
# Address of STOCK_AGENT_PRIVATE_KEY: authorized on the oracle and as default agent on new ETFs
AGENT_WALLET_ADDRESS=
# Receives the protocol's share of ETF fees, and that share (bps, max 3000 = 30%)
PROTOCOL_TREASURY_ADDRESS=
PROTOCOL_FEE_BPS=2000
# Every vault trade must fill within this many bps of the oracle price (max 300)
MAX_SLIPPAGE_BPS=100

# --- Mainnet only (scripts/deploy.mjs --network base) --------------------------
# Uniswap V3 SwapRouter02 on Base
SWAP_ROUTER_ADDRESS=
# Chainlink L2 sequencer uptime feed on Base
SEQUENCER_UPTIME_FEED=
# Chainalysis-style sanctions oracle (isSanctioned(address)); strongly advised
SANCTIONS_LIST_ADDRESS=
# Per-ETF size cap in USD for the staged launch (0 = none)
TVL_CAP_USD=100000
# Listings (feeds + pool fee tiers); copy scripts/mainnet-listings.example.json
MAINNET_LISTINGS=scripts/mainnet-listings.json
# Pushed prices are disabled on mainnet (feeds only). Set true only as a deliberate fallback.
ALLOW_PUSHED_PRICES_ON_MAINNET=false
# /api/health fails when the agent wallet holds less than this
MIN_AGENT_BALANCE_ETH=0.005

# --- Geo restriction (src/middleware.ts) --------------------------------------
# Defaults on mainnet: US,CU,IR,KP,SY and regions UA-43,UA-14,UA-09. Testnet: none.
BLOCKED_COUNTRIES=
BLOCKED_REGIONS=
GEO_FAIL_CLOSED=false

# --- Wallet login: Reown AppKit (https://dashboard.reown.com) -----------------
NEXT_PUBLIC_REOWN_PROJECT_ID=

# --- Market data ---------------------------------------------------------------
# Server-only key for /api/market (https://pro.coinmarketcap.com)
CMC_API_KEY=
