# --- Base Sepolia tokenized stocks -------------------------------------------
# Deployer: owns the exchange + factory and admins every token. LOCAL ONLY (deploy scripts); never set it on Vercel.
# Generated by `node scripts/deploy-base-sepolia.mjs` if missing. TESTNET ONLY, never reuse on mainnet.
DEPLOYER_PRIVATE_KEY=
# Web server signer: price sync, flagship rebalance, faucet mints. Required in production and must differ from the
# deployer. Generate it and grant its roles with `node scripts/setup-agent-key.mjs`. (Local dev falls back to the deployer.)
STOCK_AGENT_PRIVATE_KEY=
# Bearer secret for /api/stocks/agent rebalance/set-weights and the Vercel cron NAV sync
STOCK_AGENT_SECRET=
CRON_SECRET=
# ETF platform: who receives the protocol's share of ETF fees, and how big that share is (bps, max 3000 = 30%)
PROTOCOL_TREASURY_ADDRESS=
PROTOCOL_FEE_BPS=2000
# Price/rebalance bot authorized on the exchange and on every new ETF (defaults to the deployer)
AGENT_WALLET_ADDRESS=
# Optional RPCs (defaults to https://sepolia.base.org)
BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# --- Login: Reown AppKit (https://dashboard.reown.com) ------------------------
NEXT_PUBLIC_REOWN_PROJECT_ID=

# --- Coinbase Developer Platform (https://portal.cdp.coinbase.com) -----------
NEXT_PUBLIC_CDP_PROJECT_ID=
# Server-only secret API key (never prefix with NEXT_PUBLIC_)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- Existing app settings ----------------------------------------------------
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTH_KEY=
GEMINI_API_KEY=
ONEINCH_API_KEY=
BACKEND_URL=http://localhost:8080

# --- CoinMarketCap -----------------------------------------------------------
# Server-only key for /api/market (https://pro.coinmarketcap.com)
CMC_API_KEY=

# --- External agents (Hermes, OpenClaw, Grok bots, ...) ----------------------
# Users create agents at /dashboard/agents. Each agent gets its own wallet, derived from this seed (never stored).
# Generate with `openssl rand -hex 32`. Keep it secret and backed up: losing it loses every agent wallet.
AGENT_WALLET_SEED=
# Agent registry (API key hashes, owners, limits). Required on Vercel; locally falls back to .data/agents.json.
# Supabase: run supabase/migrations/*_agent_accounts.sql once, then set the URL and service-role key (server only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ...or Upstash Redis / Vercel KV instead
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Testnet gas sponsorship: STOCK_AGENT_PRIVATE_KEY tops up agent wallets below AGENT_GAS_MIN_ETH. Set to "off" to disable.
AGENT_GAS_SPONSOR=on
AGENT_GAS_MIN_ETH=0.0003
AGENT_GAS_TOPUP_ETH=0.001

# --- Verify with X (/verify) --------------------------------------------------
# Create an app at https://developer.x.com with OAuth 2.0 on (type "Web App", scopes users.read + tweet.read) and
# callback URL https://<your-domain>/api/verify-x/callback (plus http://localhost:3000/api/verify-x/callback for dev).
# Links are stored in the same database as agent accounts (run supabase/migrations/*_x_links.sql for Supabase).
X_CLIENT_ID=
X_CLIENT_SECRET=
# Signs the short-lived OAuth cookie. At least 32 chars: `openssl rand -base64 32`.
X_VERIFY_SECRET=
# Optional: exact callback URL registered with X, if it differs from <request origin>/api/verify-x/callback
X_REDIRECT_URI=

# --- Admin (/admin) ----------------------------------------------------------
# /admin (platform health, analytics, users, agents) opens only for ADMIN_EMAIL in src/lib/admin/auth.ts, proven by a
# Supabase Auth email code. Needs Supabase URL + anon key (above) and this session-signing secret; unset = /admin is a 404.
# At least 24 chars; generate with `openssl rand -base64 32`. Rotating it signs every admin session out.
# Supabase: add <site>/admin/auth/callback to Auth > URL Configuration > Redirect URLs for the magic link.
ADMIN_SECRET=
